{
  "name": "veya",
  "version": "1.0.0",
  "private": true,
  "description": "VEYA — technical luxury apparel storefront (Stitch design + Express/SQLite backend)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:css": "tailwindcss -i src/styles.css -o public/styles.css --minify",
    "start": "node --no-warnings=ExperimentalWarning server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
