<section class="py-16 px-6 max-w-md mx-auto">
  <h1 class="font-headline-lg text-headline-lg text-primary mb-8">Activate your account</h1>
  {%- form 'activate_customer_password', class: 'space-y-4' -%}
    <div class="errors">{{ form.errors | default_errors }}</div>
    <div><label class="field-label" for="ac-1">Password</label><input class="field" id="ac-1" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div><label class="field-label" for="ac-2">Confirm password</label><input class="field" id="ac-2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button type="submit" class="w-full h-[52px] rounded-full bg-primary text-on-primary font-headline-sm text-headline-sm hover:bg-secondary transition-colors amber-glow-hover">Activate account</button>
    <button type="submit" name="decline" class="w-full h-[52px] rounded-full border border-outline-variant/40 text-primary font-label-md uppercase tracking-widest">Decline invitation</button>
  {%- endform -%}
</section>
