<section class="py-16 px-6 md:px-12 max-w-4xl mx-auto">
  <a href="{{ routes.account_url }}" class="font-label-md text-secondary uppercase tracking-widest hover:underline">← Account</a>
  <h1 class="font-headline-lg text-headline-lg text-primary mt-4 mb-2">Order {{ order.name }}</h1>
  <p class="font-body-md text-on-surface-variant mb-8">Placed {{ order.created_at | date: '%B %d, %Y' }} · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p>
  <ul class="divide-y divide-outline-variant/30 border-y border-outline-variant/30">
    {%- for line_item in order.line_items -%}
      <li class="py-4 flex justify-between gap-4">
        <div>
          <p class="font-headline-sm text-primary">{{ line_item.title | escape }}</p>
          <p class="font-label-md text-on-surface-variant">Qty {{ line_item.quantity }}</p>
          {%- if line_item.fulfillment -%}
            <p class="font-label-sm text-secondary uppercase mt-1">Shipped {{ line_item.fulfillment.created_at | date: '%b %d' }}{% if line_item.fulfillment.tracking_url %} · <a class="underline" href="{{ line_item.fulfillment.tracking_url }}">Track</a>{% endif %}</p>
          {%- endif -%}
        </div>
        <span class="text-primary">{{ line_item.final_line_price | money }}</span>
      </li>
    {%- endfor -%}
  </ul>
  <div class="mt-6 space-y-1 text-right font-body-md text-on-surface-variant">
    <p>Subtotal {{ order.line_items_subtotal_price | money }}</p>
    {%- for shipping_method in order.shipping_methods -%}<p>Shipping ({{ shipping_method.title }}) {{ shipping_method.price | money }}</p>{%- endfor -%}
    {%- for tax_line in order.tax_lines -%}<p>{{ tax_line.title }} {{ tax_line.price | money }}</p>{%- endfor -%}
    <p class="font-headline-sm text-primary">Total {{ order.total_price | money }}</p>
  </div>
  <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-8 font-body-md text-on-surface-variant">
    <div><h2 class="field-label">Shipping address</h2>{{ order.shipping_address | format_address }}</div>
    <div><h2 class="field-label">Billing address</h2>{{ order.billing_address | format_address }}</div>
  </div>
</section>
