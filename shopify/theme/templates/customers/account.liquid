<section class="py-16 px-6 md:px-12 max-w-5xl mx-auto">
  <div class="flex items-end justify-between mb-10 gap-4">
    <div>
      <span class="font-label-sm text-secondary uppercase tracking-widest block mb-2">ACCOUNT</span>
      <h1 class="font-headline-lg text-headline-lg text-primary">Hi{% if customer.first_name != blank %}, {{ customer.first_name | escape }}{% endif %}</h1>
    </div>
    <a href="{{ routes.account_logout_url }}" class="font-label-md uppercase tracking-widest text-on-surface-variant hover:text-primary">Sign out</a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
    <div class="md:col-span-2">
      <h2 class="font-headline-md text-headline-md text-primary mb-4">Orders</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <ul class="divide-y divide-outline-variant/30 border-y border-outline-variant/30">
            {%- for order in customer.orders -%}
              <li class="py-4 flex justify-between gap-4 font-body-md">
                <a href="{{ order.customer_url }}" class="text-secondary hover:underline">{{ order.name }}</a>
                <span class="text-on-surface-variant">{{ order.created_at | date: '%b %d, %Y' }}</span>
                <span class="text-on-surface-variant">{{ order.fulfillment_status_label }}</span>
                <span class="text-primary">{{ order.total_price | money }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p class="font-body-md text-on-surface-variant">No orders yet.</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
    <div>
      <h2 class="font-headline-md text-headline-md text-primary mb-4">Default address</h2>
      <div class="font-body-md text-on-surface-variant">{{ customer.default_address | format_address }}</div>
      <a href="{{ routes.account_addresses_url }}" class="inline-block mt-4 font-label-md text-secondary uppercase tracking-widest hover:underline">Manage addresses ({{ customer.addresses_count }})</a>
    </div>
  </div>
</section>
