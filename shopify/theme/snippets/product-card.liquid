{%- comment -%}
  Product card: studio photo with the on-model photo on hover, badge, colour swatches that swap the
  photos, and a quick-add size picker.
  Usage: {% render 'product-card', product: product, index: forloop.index %}

  Reads these product tags: gender:men|women, category:tops|layers|bottoms, badge:<text>, material:<text>.
{%- endcomment -%}
{%- liquid
  assign gender = 'unisex'
  assign category = ''
  assign badge = ''
  assign material = ''
  for tag in product.tags
    assign t = tag | downcase
    if t contains 'gender:'
      assign gender = t | remove_first: 'gender:' | strip
    elsif t contains 'category:'
      assign category = t | remove_first: 'category:' | strip
    elsif t contains 'badge:'
      assign badge = tag | split: ':' | last | strip
    elsif t contains 'material:'
      assign material = tag | remove_first: 'material:' | remove_first: 'Material:' | strip
    endif
  endfor
  assign gender_label = ''
  if gender == 'men'
    assign gender_label = "Men's · "
  elsif gender == 'women'
    assign gender_label = "Women's · "
  endif

  assign color_option = nil
  assign size_option = nil
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour'
      assign color_option = option
    elsif oname == 'size'
      assign size_option = option
    endif
  endfor

  assign studio = product.featured_media
  assign model = nil
  if product.media.size > 1
    assign model = product.media[1]
  endif
-%}
<div class="product-card group flex flex-col min-w-0 bg-surface-container-low rounded-xl border border-outline-variant/20 overflow-hidden hover:border-outline-variant/60 transition-all duration-300"
  data-product-card
  data-gender="{{ gender }}"
  data-category="{{ category }}"
  data-price="{{ product.price }}"
  data-title="{{ product.title | escape }}"
  data-index="{{ index | default: 0 }}"
  data-available="{{ product.available }}"
  data-badge="{{ badge | escape }}">
  {% render 'product-data', product: product %}
  <div class="relative aspect-[4/5] bg-surface-container-lowest overflow-hidden">
    <a href="{{ product.url }}" class="block w-full h-full" aria-label="{{ product.title | escape }}">
      {%- if studio -%}
        {{ studio.preview_image | image_url: width: 900 | image_tag:
          class: 'js-card-image w-full h-full object-cover group-hover:scale-105 transition-transform duration-500',
          loading: 'lazy',
          sizes: '(min-width: 1024px) 25vw, 50vw',
          widths: '360, 540, 720, 900',
          alt: product.title
        }}
      {%- else -%}
        <div class="w-full h-full flex items-center justify-center font-label-md text-on-surface-variant uppercase">No photo yet</div>
      {%- endif -%}
      {%- if model -%}
        {{ model.preview_image | image_url: width: 900 | image_tag:
          class: 'js-card-model absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-500',
          loading: 'lazy',
          sizes: '(min-width: 1024px) 25vw, 50vw',
          widths: '360, 540, 720, 900',
          alt: ''
        }}
      {%- endif -%}
    </a>
    {%- if badge != blank -%}
      <div class="absolute top-3 left-3 pointer-events-none">
        <span class="font-label-sm text-label-sm md:text-label-md px-2 py-0.5 rounded bg-surface-container-lowest/80 border border-outline-variant/30 text-secondary uppercase tracking-widest">{{ badge | escape }}</span>
      </div>
    {%- endif -%}
    {%- if product.available -%}
      <button type="button" data-quick-open aria-label="Quick add {{ product.title | escape }}" aria-expanded="false" class="absolute bottom-3 right-3 w-9 h-9 rounded-full bg-surface-container-lowest/90 border border-outline-variant/40 flex items-center justify-center text-primary hover:bg-secondary hover:text-surface-container-lowest transition-colors duration-200">
        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">add</span>
      </button>
      <div class="quick-sizes absolute inset-x-0 bottom-0 bg-surface-container-lowest/95 backdrop-blur-md border-t border-outline-variant/30 p-3" data-quick-sizes>
        <div class="flex items-center justify-between mb-2">
          <span class="field-label !mb-0">Add size</span>
          <button type="button" data-quick-close aria-label="Close" class="text-on-surface-variant hover:text-primary"><span class="material-symbols-outlined text-[16px]" aria-hidden="true">close</span></button>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {%- if size_option -%}
            {%- for value in size_option.values -%}
              <button type="button" data-quick-size="{{ value | escape }}" class="min-w-[38px] h-8 px-2 rounded-md border border-outline-variant/50 font-label-md text-primary hover:border-secondary hover:text-secondary disabled:opacity-30 disabled:line-through disabled:pointer-events-none">{{ value }}</button>
            {%- endfor -%}
          {%- else -%}
            <button type="button" data-quick-size="" class="h-8 px-3 rounded-md border border-outline-variant/50 font-label-md text-primary hover:border-secondary">Add to bag</button>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
  <div class="p-3 md:p-5 flex flex-col justify-between flex-grow">
    <a href="{{ product.url }}" class="block">
      <span class="font-label-sm text-label-sm md:text-label-md text-secondary uppercase tracking-widest block mb-1">{{ gender_label }}{{ product.type | escape }}</span>
      <h3 class="font-headline-sm text-[15px] md:text-headline-sm text-primary mb-1">{{ product.title | escape }}</h3>
      {%- if material != blank -%}
        <p class="hidden md:block font-label-md text-on-surface-variant font-normal">{{ material | escape }}</p>
      {%- endif -%}
    </a>
    <div class="mt-3 md:mt-4 pt-3 border-t border-outline-variant/20 flex flex-wrap gap-2 items-center justify-between">
      <span class="font-label-md text-[14px] font-medium tracking-wide text-primary">
        {%- if product.available -%}
          {%- if product.price_varies -%}From {% endif -%}{{ product.price | money_without_trailing_zeros }}
        {%- else -%}SOLD OUT{%- endif -%}
      </span>
      {%- if color_option -%}
        <div class="flex items-center gap-1.5" role="group" aria-label="Colours">
          {%- for value in color_option.values -%}
            {%- capture hex -%}{% render 'color-hex', name: value %}{%- endcapture -%}
            <button type="button" class="swatch w-3 h-3 rounded-full border border-outline-variant {% if forloop.first %}swatch-active{% endif %}" style="background: {{ hex | strip }};" title="{{ value | escape }}" aria-label="{{ value | escape }}" aria-pressed="{{ forloop.first }}" data-swatch="{{ value | escape }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
