{%- comment -%}
  The members' vote: "What should we make next?" Each option is a block. Voting uses Shopify's
  customer form, so the voter joins the Collective (email marketing) and is tagged
  "vote:<vote id>:<option>", e.g. vote:next-drop-1:ribbed-beanie. To count the votes, go to Shopify
  admin → Customers and filter by that tag. For a new vote, change the options and the vote id.
  veya.js sends the vote without leaving the page and remembers it in the browser.
{%- endcomment -%}
{%- assign poll_id = section.settings.poll_id | handleize | default: 'vote' -%}
<section id="vote" class="py-24 px-6 md:px-12 max-w-7xl mx-auto w-full" data-vote data-poll="{{ poll_id }}">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
        <span class="font-label-sm text-secondary uppercase tracking-widest">{{ section.settings.eyebrow | escape }}</span>
      </div>
      <h2 class="font-headline-lg text-headline-lg text-primary">{{ section.settings.question | escape }}</h2>
    </div>
    <p class="font-body-md text-body-md text-on-surface-variant max-w-md">{{ section.settings.text | escape }}</p>
  </div>

  {%- form 'customer', id: 'vote-form' -%}
    <div data-vote-ballot>
      <fieldset>
        <legend class="sr-only">{{ section.settings.question | escape }}</legend>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
          {%- for block in section.blocks -%}
            <label class="group rounded-xl border border-outline-variant/40 bg-surface-container-low/60 p-5 md:p-6 flex flex-col gap-2 sm:min-h-[196px] cursor-pointer transition-colors duration-200 hover:border-secondary/50 has-[:checked]:border-secondary has-[:checked]:bg-surface-container-lowest has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-secondary" {{ block.shopify_attributes }}>
              <input type="radio" name="contact[tags]" value="collective, vote:{{ poll_id }}:{{ block.settings.name | handleize }}" class="sr-only" required data-vote-option="{{ block.settings.name | escape }}">
              <span class="h-6 flex items-center justify-between gap-2">
                <span class="font-label-sm text-label-sm tracking-[0.2em] text-on-surface-variant">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <span class="w-5 h-5 rounded-full border border-outline-variant flex items-center justify-center transition-colors group-has-[:checked]:border-secondary group-has-[:checked]:bg-secondary" aria-hidden="true"><span class="material-symbols-outlined text-[13px] text-on-secondary opacity-0 group-has-[:checked]:opacity-100">check</span></span>
              </span>
              <span class="font-headline-sm text-headline-sm text-primary">{{ block.settings.name | escape }}</span>
              <span class="font-body-sm text-body-sm text-on-surface-variant">{{ block.settings.note | escape }}</span>
              <span class="mt-auto pt-4 font-label-sm text-label-sm uppercase tracking-widest text-secondary">
                <span class="opacity-0 transition-opacity group-hover:opacity-100 group-has-[:checked]:hidden">Pick this</span>
                <span class="hidden group-has-[:checked]:inline">Your pick</span>
              </span>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>
      <div class="mt-8 flex flex-col md:flex-row md:items-center gap-4">
        <label class="w-full md:max-w-sm"><span class="sr-only">Email address</span><input name="contact[email]" type="email" autocomplete="email" required placeholder="Your email address" class="w-full h-[52px] px-5 rounded-full bg-surface-container-lowest border border-outline-variant/40 text-primary placeholder-on-surface-variant/50 focus:border-secondary focus:ring-0 font-body-md outline-none"></label>
        <button type="submit" class="h-[52px] px-8 rounded-full bg-primary text-on-primary font-headline-sm text-headline-sm hover:bg-secondary transition-colors duration-300 amber-glow-hover whitespace-nowrap flex items-center justify-center gap-2 disabled:opacity-60">
          <span>{{ section.settings.button | escape }}</span><span class="material-symbols-outlined text-[18px]" aria-hidden="true">how_to_vote</span>
        </button>
        <p class="font-body-sm text-body-sm text-outline md:max-w-xs">{{ section.settings.consent | escape }}</p>
      </div>
      <p class="mt-4 font-body-md text-body-md text-error min-h-[22px]" aria-live="polite" data-vote-error>
        {%- if form.errors -%}{%- if form.errors contains 'email' -%}Please enter a valid email address.{%- else -%}{{ form.errors | default_errors }}{%- endif -%}{%- endif -%}
      </p>
    </div>
    <div class="rounded-xl border border-secondary bg-surface-container-lowest p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-5 md:gap-8" role="status" data-vote-done hidden>
      <span class="w-12 h-12 shrink-0 rounded-full bg-secondary text-on-secondary flex items-center justify-center"><span class="material-symbols-outlined text-[24px]" aria-hidden="true">how_to_vote</span></span>
      <div class="space-y-1">
        <p class="font-headline-md text-headline-md text-primary">Thanks, your vote is in.</p>
        <p class="font-body-md text-body-md text-on-surface-variant">You picked <span class="text-primary font-semibold" data-vote-choice></span>. {{ section.settings.thanks | escape }}</p>
      </div>
    </div>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Members' vote",
  "class": "section-member-vote",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "THE MEMBERS' VOTE" },
    { "type": "text", "id": "question", "label": "Question", "default": "What should we make next?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Members choose what VEYA makes next. Pick one and add your email to vote." },
    {
      "type": "text", "id": "poll_id", "label": "Vote id", "default": "next-drop-1",
      "info": "Part of each voter's customer tag, e.g. vote:next-drop-1:ribbed-beanie. Change it when you start a new vote."
    },
    { "type": "text", "id": "button", "label": "Button", "default": "Cast my vote" },
    { "type": "text", "id": "consent", "label": "Sign-up note", "default": "Voting makes you a member of the VEYA Collective. Leave anytime." },
    { "type": "text", "id": "thanks", "label": "After voting", "default": "We'll share the results with the Collective." }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Option",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Ribbed Beanie" },
        { "type": "text", "id": "note", "label": "Description", "default": "A chunky rib-knit beanie with a small embroidered VEYA." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Members' vote",
      "blocks": [
        { "type": "option", "settings": { "name": "Ribbed Beanie", "note": "A chunky rib-knit beanie with a small embroidered VEYA." } },
        { "type": "option", "settings": { "name": "Washed Dad Cap", "note": "Soft washed cotton, low profile, in the VEYA colours." } },
        { "type": "option", "settings": { "name": "Heavyweight Crew Socks", "note": "Thick ribbed socks to finish every sweat set." } },
        { "type": "option", "settings": { "name": "Canvas Tote", "note": "A heavy canvas tote for the everyday carry." } }
      ]
    }
  ]
}
{% endschema %}
