<section class="min-h-[70vh] flex items-center justify-center px-6">
  <div class="max-w-md w-full text-center space-y-6">
    <p class="text-headline-lg font-display text-primary">{{ shop.name | upcase }}<span class="inline-block w-2 h-2 ml-1 rounded-full bg-secondary"></span></p>
    {%- if shop.password_message != blank -%}<p class="font-body-lg text-on-surface-variant">{{ shop.password_message }}</p>{%- else -%}<p class="font-body-lg text-on-surface-variant">Opening soon. Join the list to hear first.</p>{%- endif -%}
    {%- form 'customer', class: 'flex flex-col sm:flex-row gap-3' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, prospect">
      {%- if form.posted_successfully? -%}
        <p class="font-label-md text-secondary uppercase tracking-wider w-full">You're on the list.</p>
      {%- else -%}
        <input class="field !rounded-full flex-grow" type="email" name="contact[email]" placeholder="Your email address" aria-label="Email address" required>
        <button class="h-12 px-6 rounded-full bg-primary text-on-primary font-label-md uppercase tracking-widest hover:bg-secondary" type="submit">Notify me</button>
      {%- endif -%}
    {%- endform -%}
    <details class="pt-6 border-t border-outline-variant/30 text-left">
      <summary class="font-label-md text-on-surface-variant uppercase tracking-widest cursor-pointer">Store owner? Enter password</summary>
      {%- form 'storefront_password', class: 'mt-4 flex gap-3' -%}
        <input class="field" type="password" name="password" placeholder="Password" aria-label="Password">
        <button class="h-12 px-6 rounded-full bg-primary text-on-primary font-label-md uppercase tracking-widest" type="submit">Enter</button>
        {{ form.errors | default_errors }}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
