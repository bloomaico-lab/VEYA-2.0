{%- comment -%}Shop by category: Tops / Layers / Bottoms cards with live style counts and starting prices.{%- endcomment -%}
{%- assign all_url = routes.all_products_collection_url -%}
<section class="py-24 px-6 md:px-12 max-w-7xl mx-auto border-t border-outline-variant/20" id="categories">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-secondary"></span>
        <span class="font-label-sm text-secondary uppercase tracking-widest">{{ section.settings.eyebrow | escape }}</span>
      </div>
      <h2 class="font-headline-lg text-headline-lg text-primary">{{ section.settings.heading | escape }}</h2>
    </div>
    <p class="font-body-md text-body-md text-on-surface-variant max-w-md">{{ section.settings.text | escape }}</p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {%- for n in (1..3) -%}
      {%- liquid
        case n
          when 1
            assign c = 'tops'
            assign title = 'Shop Tops'
            assign tagline = section.settings.tops_tag
            assign blurb = section.settings.tops_text
            assign image = section.settings.tops_image
          when 2
            assign c = 'layers'
            assign title = 'Shop Layers'
            assign tagline = section.settings.layers_tag
            assign blurb = section.settings.layers_text
            assign image = section.settings.layers_image
          else
            assign c = 'bottoms'
            assign title = 'Shop Bottoms'
            assign tagline = section.settings.bottoms_tag
            assign blurb = section.settings.bottoms_text
            assign image = section.settings.bottoms_image
        endcase
        assign needle = 'category:' | append: c
        assign count = 0
        assign from = 0
        for product in collections.all.products
          assign tags = product.tags | join: '|' | downcase
          if tags contains needle
            assign count = count | plus: 1
            if from == 0 or product.price < from
              assign from = product.price
            endif
          endif
        endfor
        assign fallback = c | append: '.jpg'
      -%}
      <a href="{{ all_url }}/category-{{ c }}" data-nav-gender="all" data-nav-filter="{{ c }}" class="group relative rounded-xl overflow-hidden bg-surface-container-low border border-outline-variant/30 transition-all duration-500 hover:border-secondary/40 flex flex-col">
        <div class="relative aspect-[4/5] overflow-hidden bg-surface-container-lowest">
          {%- if image -%}
            {{ image | image_url: width: 1000 | image_tag: class: 'w-full h-full object-cover transition-transform duration-700 group-hover:scale-105', loading: 'lazy', sizes: '(min-width: 768px) 33vw, 100vw', widths: '500, 750, 1000', alt: image.alt }}
          {%- else -%}
            <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" src="{{ fallback | asset_url }}" alt="" loading="lazy" width="896" height="1200">
          {%- endif -%}
          <div class="absolute top-4 left-4">
            <span class="px-2.5 py-1 rounded bg-surface-container-lowest/80 border border-outline-variant/30 backdrop-blur-md font-label-sm text-secondary uppercase tracking-widest">{{ tagline | escape }}</span>
          </div>
          <div class="absolute bottom-4 right-4">
            <span class="w-8 h-8 rounded-full bg-surface-container-lowest/90 border border-outline-variant/40 flex items-center justify-center text-primary group-hover:text-secondary group-hover:border-secondary transition-colors duration-200">
              <span class="material-symbols-outlined text-[16px]" aria-hidden="true">north_east</span>
            </span>
          </div>
        </div>
        <div class="p-6 flex flex-col justify-between flex-grow bg-surface-container-low/80 backdrop-blur-md">
          <div>
            <h3 class="font-headline-md text-headline-md text-primary mb-2">{{ title }}</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed mb-4">{{ blurb | escape }}</p>
          </div>
          <div class="pt-4 border-t border-outline-variant/20 flex items-center justify-between text-label-sm font-label-sm text-on-surface-variant uppercase">
            <span>{{ count }} {% if count == 1 %}style{% else %}styles{% endif %}</span>
            {%- if from > 0 -%}<span class="text-secondary">From {{ from | money_without_trailing_zeros }}</span>{%- endif -%}
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "SHOP BY CATEGORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your everyday fit." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A small range of basics that work together: tops, layers and bottoms you will wear on repeat." },
    { "type": "header", "content": "Tops" },
    { "type": "image_picker", "id": "tops_image", "label": "Photo" },
    { "type": "text", "id": "tops_tag", "label": "Label", "default": "Tees · Long Sleeves" },
    { "type": "text", "id": "tops_text", "label": "Text", "default": "Oversized and fitted tees and heavyweight long sleeves." },
    { "type": "header", "content": "Layers" },
    { "type": "image_picker", "id": "layers_image", "label": "Photo" },
    { "type": "text", "id": "layers_tag", "label": "Label", "default": "Quarter-Zips · Hoodies · Crews" },
    { "type": "text", "id": "layers_text", "label": "Text", "default": "Heavyweight fleece quarter-zips, oversized hoodies and sweatshirts." },
    { "type": "header", "content": "Bottoms" },
    { "type": "image_picker", "id": "bottoms_image", "label": "Photo" },
    { "type": "text", "id": "bottoms_tag", "label": "Label", "default": "Sweats · Leggings" },
    { "type": "text", "id": "bottoms_text", "label": "Text", "default": "Straight, wide-leg and cargo sweatpants and flare leggings." }
  ],
  "presets": [{ "name": "Shop by category" }]
}
{% endschema %}
