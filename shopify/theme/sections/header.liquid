{%- comment -%}
  Header: the looping announcement bar (edit its messages in the theme editor) and the main navigation.
  Men / Women / category links point at tag-filtered collection pages (/collections/all/gender-men);
  on the home page they filter the product grid in place instead.
{%- endcomment -%}
{%- liquid
  assign all_url = routes.all_products_collection_url
  assign nav_class = 'nav-link text-on-surface-variant hover:text-primary tracking-widest font-label-md uppercase transition-colors duration-200 border-b border-transparent pb-1'
-%}
<header class="fixed top-0 inset-x-0 z-50 bg-surface/80 backdrop-blur-2xl shadow-sm" data-header>
  {%- capture ticker_items -%}
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="hover:underline underline-offset-4" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
        {%- else -%}
          <span class="ticker-text" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
        {%- endif -%}
        <span class="ticker-dot" aria-hidden="true"></span>
      {%- endfor -%}
    {%- else -%}
      <a href="{{ shop.shipping_policy.url | default: '/policies/shipping-policy' }}" class="hover:underline underline-offset-4">Free shipping on orders over {{ settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros }}</a><span class="ticker-dot" aria-hidden="true"></span>
      <a href="{{ all_url }}/gender-women" class="hover:underline underline-offset-4">New for women: flare leggings &amp; wide-leg sweats</a><span class="ticker-dot" aria-hidden="true"></span>
      <a href="{{ all_url }}/gender-men" class="hover:underline underline-offset-4">New for men: quarter-zips &amp; cargo sweats</a><span class="ticker-dot" aria-hidden="true"></span>
      <span class="ticker-text">Free 30-day size exchanges</span><span class="ticker-dot" aria-hidden="true"></span>
      <span class="ticker-text">Made to order · ships in 2–4 business days</span><span class="ticker-dot" aria-hidden="true"></span>
      <a href="{{ routes.search_url }}?q=matching+set&type=product" class="hover:underline underline-offset-4">Matching hoodie &amp; sweatpant sets</a><span class="ticker-dot" aria-hidden="true"></span>
    {%- endif -%}
  {%- endcapture -%}
  <div class="ticker bg-primary text-on-primary font-label-sm text-label-sm uppercase tracking-widest py-2" role="region" aria-label="Offers and shipping">
    <div class="ticker-track">
      <div class="ticker-group">{{ ticker_items }}</div>
      <div class="ticker-group" aria-hidden="true" data-ticker-copy>{{ ticker_items }}</div>
    </div>
  </div>

  <div class="flex justify-between items-center w-full px-6 md:px-12 py-4 max-w-7xl mx-auto">
    <a class="text-headline-md font-display tracking-tight text-primary transition-all duration-300 ease-out active:scale-95 flex items-center gap-2" href="{{ routes.root_url }}">
      {%- if section.settings.logo -%}
        {{ section.settings.logo | image_url: width: 240 | image_tag: class: 'h-8 w-auto', alt: shop.name }}
      {%- else -%}
        <span>{{ shop.name | upcase }}</span>
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-secondary"></span>
      {%- endif -%}
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Main">
      <a class="{{ nav_class }}" href="{{ all_url }}" data-nav-gender="all" data-nav-filter="all">Shop All</a>
      <a class="{{ nav_class }}" href="{{ all_url }}/gender-men" data-nav-gender="men" data-nav-filter="all">Men</a>
      <a class="{{ nav_class }}" href="{{ all_url }}/gender-women" data-nav-gender="women" data-nav-filter="all">Women</a>
      <a class="{{ nav_class }}" href="{{ all_url }}/category-tops" data-nav-gender="all" data-nav-filter="tops">Tops</a>
      <a class="{{ nav_class }}" href="{{ all_url }}/category-layers" data-nav-gender="all" data-nav-filter="layers">Layers</a>
      <a class="{{ nav_class }}" href="{{ all_url }}/category-bottoms" data-nav-gender="all" data-nav-filter="bottoms">Bottoms</a>
      <a class="text-on-surface-variant hover:text-primary tracking-widest font-label-md uppercase transition-colors duration-200" href="{{ section.settings.help_link | default: '/policies/shipping-policy' }}">Help</a>
    </nav>

    <div class="flex items-center gap-5 md:gap-6">
      <button id="menu-btn" type="button" aria-label="Open menu" class="lg:hidden text-on-surface-variant hover:text-secondary transition-colors duration-200 flex items-center" data-open="menu-overlay">
        <span class="material-symbols-outlined text-[22px]" aria-hidden="true">menu</span>
      </button>
      <a href="{{ routes.search_url }}" id="search-btn" aria-label="Search products" class="text-on-surface-variant hover:text-secondary transition-colors duration-200 flex items-center" data-open="search-overlay">
        <span class="material-symbols-outlined text-[20px]" aria-hidden="true">search</span>
      </a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="hidden sm:inline-block text-on-surface-variant hover:text-primary tracking-widest font-label-md uppercase transition-colors duration-200">
          {%- if customer -%}{{ customer.first_name | default: 'Account' }}{%- else -%}Account{%- endif -%}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" id="bag-btn" aria-label="Open bag" data-open="bag-overlay" class="group flex items-center gap-2.5 py-1.5 px-3 rounded-full bg-surface-container-high/60 border border-outline-variant/30 hover:border-secondary/40 transition-all duration-300">
        <span class="material-symbols-outlined text-[18px] text-secondary group-hover:scale-110 transition-transform duration-200" aria-hidden="true">shopping_bag</span>
        <span id="bag-count" class="font-label-md tracking-wider text-primary">Bag ({{ cart.item_count }})</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "max_blocks": 10,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Leave empty to show the store name as text."
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "Help link",
      "info": "Defaults to your shipping policy."
    },
    {
      "type": "paragraph",
      "content": "Announcement bar: add a message block for each offer. With no blocks, VEYA's default messages are shown."
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Banner message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Free shipping on orders over $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
