<section class="py-16 px-6 md:px-12 max-w-7xl mx-auto">
  <h1 class="font-headline-lg text-headline-lg text-primary mb-8">Collections</h1>
  <div class="grid grid-cols-2 lg:grid-cols-3 gap-6">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="group block rounded-xl overflow-hidden border border-outline-variant/30 bg-surface-container-low">
        <div class="aspect-[4/5] bg-surface-container-lowest overflow-hidden">
          {%- assign img = collection.featured_image | default: collection.products.first.featured_image -%}
          {%- if img -%}{{ img | image_url: width: 800 | image_tag: class: 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-500', loading: 'lazy', alt: collection.title }}{%- endif -%}
        </div>
        <div class="p-4 flex justify-between items-center">
          <span class="font-headline-sm text-primary">{{ collection.title | escape }}</span>
          <span class="font-label-sm text-on-surface-variant uppercase">{{ collection.products_count }} items</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
