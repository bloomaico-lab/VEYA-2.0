{%- comment -%}
  Who we're for: VEYA's brand promise on navy, with up to four values beside it.
  Everything here is edited in the theme editor.
{%- endcomment -%}
<section id="manifesto" class="relative bg-primary text-on-primary overflow-hidden">
  <div class="absolute -top-48 -right-40 w-[560px] h-[560px] rounded-full bg-secondary/40 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-6 md:px-12 py-24 md:py-32 grid grid-cols-1 lg:grid-cols-12 gap-14 lg:gap-16 items-center">
    <div class="{% if section.blocks.size > 0 %}lg:col-span-6{% else %}lg:col-span-8{% endif %} space-y-8">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-on-primary/70"></span>
        <span class="font-label-sm text-label-sm uppercase tracking-[0.25em] text-on-primary/70">{{ section.settings.eyebrow | escape }}</span>
      </div>
      <h2 class="font-display text-[44px] leading-[1.04] md:text-[64px] md:leading-[1.02] tracking-tight">{{ section.settings.heading | escape }}</h2>
      <p class="font-body-lg text-body-lg text-on-primary/80 max-w-xl leading-relaxed">{{ section.settings.text | escape }}</p>
      {%- if section.settings.button_label != blank or section.settings.link_label != blank and section.settings.link != blank -%}
        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link | default: '/#collective' }}" class="h-[52px] px-8 rounded-full bg-on-primary text-primary font-headline-sm text-headline-sm flex items-center justify-center gap-2 hover:bg-surface-container-high transition-colors duration-300">
              <span>{{ section.settings.button_label | escape }}</span><span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
            </a>
          {%- endif -%}
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            <a href="{{ section.settings.link }}" class="h-[52px] px-8 rounded-full border border-on-primary/30 text-on-primary font-headline-sm text-headline-sm flex items-center justify-center hover:border-on-primary transition-colors duration-300">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-9" aria-label="What {{ shop.name | escape }} stands for">
        {%- for block in section.blocks -%}
          <li class="border-t border-on-primary/20 pt-5" {{ block.shopify_attributes }}>
            <span class="font-label-sm text-label-sm tracking-[0.2em] text-on-primary/60">0{{ forloop.index }}</span>
            <h3 class="font-headline-sm text-headline-sm mt-2">{{ block.settings.title | escape }}</h3>
            <p class="font-body-md text-body-md text-on-primary/75 mt-1">{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Who we're for",
  "class": "section-manifesto",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "WHO WE'RE FOR" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "For who you're becoming." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "VEYA is for people building something: a routine, a craft, a life that's theirs. We make the everyday pieces that come along for all of it. Made to order, made to last and made to go with everything else you own." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Join the Collective" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave empty to go to the Collective sign-up on the home page." },
    { "type": "text", "id": "link_label", "label": "Second button", "default": "Our approach" },
    { "type": "url", "id": "link", "label": "Second button link", "info": "For example your Our Approach page. The button is hidden without a link." }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fewer, better" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A small range of heavyweight basics we keep improving, instead of a new trend every week." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Who we're for",
      "blocks": [
        { "type": "value", "settings": { "title": "Fewer, better", "text": "A small range of heavyweight basics we keep improving, instead of a new trend every week." } },
        { "type": "value", "settings": { "title": "Made for you", "text": "Every piece is made when you order it. No overstock, no end-of-season pile." } },
        { "type": "value", "settings": { "title": "One palette", "text": "Earthy colours that all go together, so every new piece works with the ones you already own." } },
        { "type": "value", "settings": { "title": "Built to stay", "text": "Pre-shrunk cotton and heavyweight fleece that keep their shape, so today's favourites are still in rotation years from now." } }
      ]
    }
  ]
}
{% endschema %}
