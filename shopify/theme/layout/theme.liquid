<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#F5EFE4">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=Hanken+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    {{ 'veya.css' | asset_url | stylesheet_tag }}

    <script>
      window.veya = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          allProducts: {{ routes.all_products_collection_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        freeShippingCents: {{ settings.free_shipping_threshold | times: 100 | json }}
      };
    </script>
    <script src="{{ 'veya.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="bg-background text-on-background selection:bg-secondary selection:text-surface-container-lowest antialiased overflow-x-hidden min-h-screen flex flex-col justify-between template-{{ template.name }}">
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[70] focus:bg-primary focus:text-on-primary focus:px-4 focus:py-2 focus:rounded-full" href="#MainContent">Skip to content</a>

    {% section 'header' %}

    <main id="MainContent" class="w-full pt-28 flex-grow" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% render 'cart-drawer' %}
    {% render 'search-overlay' %}
    {% render 'menu-drawer' %}
    {% section 'spin-wheel' %}

    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 translate-y-4 opacity-0 pointer-events-none z-[80] px-5 py-3 rounded-full bg-primary text-on-primary font-label-md tracking-wider shadow-lg" role="status" aria-live="polite"></div>
  </body>
</html>
